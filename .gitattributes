# Auto detect text files and perform LF normalization
* text=auto

# Unity YAML - always LF
*.mat text eol=lf
*.anim text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.controller text eol=lf

# Binary files - no diff/merge
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.fbx binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
