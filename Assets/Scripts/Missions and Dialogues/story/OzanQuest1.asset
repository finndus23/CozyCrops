  m_Script: {fileID: 11500000, guid: 126ce4a51c8200541a9368b3b76aa58b, type: 3}
  m_Name: OzanQuest1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Onkel Ozan
    text: "Ein Feld hast du geschafft. Nur: von einem Feld wird keiner satt."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: "Im Baumodus musst du nicht jedes Feld einzeln antippen — halt die Maus gedrückt und zieh über die Fläche. Acht Stück, dann reicht's für den Anfang."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: "Und beim Hacken das Wichtigste: warte nicht, bis eins fertig ist. Klick einfach weiter. Die Aufträge stellen sich hintereinander an und laufen von allein durch."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: "Verklickt? Q leert die Schlange. Der laufende Auftrag geht noch zu Ende, der Rest fliegt raus."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  missionToStartAfter: {fileID: 11400000, guid: a1c0b2d3e4f5061728394a5b6c7d8e90, type: 2}
