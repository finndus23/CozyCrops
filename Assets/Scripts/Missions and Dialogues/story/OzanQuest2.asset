  m_Script: {fileID: 11500000, guid: 126ce4a51c8200541a9368b3b76aa58b, type: 3}
  m_Name: OzanQuest2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Onkel Ozan
    text: "Acht saubere Felder. Dein Vater hat für sowas eine Woche gebraucht."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: "Hier, Karottensamen. Pflanz sie, gieß sie — zweimal pro Pflanze, einmal reicht nicht — und ernte sie ab, wenn sie reif sind."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: "Und arbeite nicht Reihe für Reihe. Jedes Werkzeug hat seine eigene Warteschlange — du kannst hinten säen, während vorne noch gegossen wird. Der Auftrag zählt jeden Schritt mit, egal in welcher Reihenfolge."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: "Wenn die Kisten voll sind, nimmst du das Auto und verkaufst die Ware beim Händler in der Stadt. Ernte, die in der Scheune liegt, ist kein Geld."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  missionToStartAfter: {fileID: 11400000, guid: b2d1c3e4f5061728394a5b6c7d8e90a1, type: 2}
