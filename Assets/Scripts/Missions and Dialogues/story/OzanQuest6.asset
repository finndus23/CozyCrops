  m_Script: {fileID: 11500000, guid: 126ce4a51c8200541a9368b3b76aa58b, type: 3}
  m_Name: OzanQuest6
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Onkel Ozan
    text: "Sonnenblumen. Dein Vater hat es zweimal versucht und beide Male aufgegeben."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: "Sie wollen doppelt so oft gegossen werden wie alles andere — vier Gänge pro Pflanze. Ohne Warteschlange läufst du dir dabei die Füße wund."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: "Sechs Stück durchziehen und verkaufen. Achtzig Gold das Stück — dann verstehst du, warum die Lizenz so teuer war."
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  missionToStartAfter: {fileID: 11400000, guid: 112233445566778899001122334455a0, type: 2}
