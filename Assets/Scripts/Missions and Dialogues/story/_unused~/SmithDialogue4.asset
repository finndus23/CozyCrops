  m_Script: {fileID: 11500000, guid: 126ce4a51c8200541a9368b3b76aa58b, type: 3}
  m_Name: SmithDialogue4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Schmied
    text: "Zeig mal her, was du da mit dir rumschleppst. Stumpf ist es, aber nicht hinüber."
    portrait: {fileID: 0}
  - speakerName: Schmied
    text: "Jede Stufe macht dich schneller. Und ab der zehnten packst du mehrere Felder auf einmal — dann arbeitest du nicht mehr, dann erntest du."
    portrait: {fileID: 0}
  - speakerName: Schmied
    text: "Such dir eins aus, ich mach dir das erste günstig. Danach fährst du heim und probierst es aus."
    portrait: {fileID: 0}
  missionToStartAfter: {fileID: 11400000, guid: d4f3e5061728394a5b6c7d8e90a1b2c3, type: 2}
