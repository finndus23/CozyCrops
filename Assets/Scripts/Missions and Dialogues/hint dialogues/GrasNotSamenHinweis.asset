  m_Script: {fileID: 11500000, guid: 126ce4a51c8200541a9368b3b76aa58b, type: 3}
  m_Name: GrasNotSamenHinweis
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Onkel Ozan
    text: He, warte mal. Kein Gold und keine Samen mehr übrig — so kommst du gerade
      nicht weiter.
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  - speakerName: Onkel Ozan
    text: Hier, nimm ein paar von meinen Samen. Die hatte ich sowieso zu viel. Bring
      sie in die Erde, gieß sie ordentlich, und beim nächsten Verkauf stehst du
      wieder auf eigenen Beinen.
    portrait: {fileID: 21300000, guid: ba11caedc4ed7bd43a4e11aeb95d84aa, type: 3}
  missionToStartAfter: {fileID: 0}
